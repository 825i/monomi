[Unit]
Description=monomi collector — bundles telemetry and POSTs to the edge worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/monomi
EnvironmentFile=/etc/monomi/collector.env
ExecStart=/usr/bin/python3 /opt/monomi/collector.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
