[Unit]
Description=monomi — Linux status page and resource monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/monomi
EnvironmentFile=-/etc/monomi/monomi.env
ExecStart=/usr/bin/python3 /opt/monomi/monomi.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
